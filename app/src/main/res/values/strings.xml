    <string name="consent_title">Anonymous statistics</string>
    <string name="consent_lead">Aura collects nothing unless you agree.</string>
    <string name="consent_funding">Paid for by donations, never by your data. A donation works whether or not you share statistics.</string>
    <string name="consent_point_sent_label">If you agree</string>
    <string name="consent_point_sent_body">App and Android version, device model, features used, setup steps and whether they worked.</string>
    <string name="consent_point_never_label">Never sent</string>
    <string name="consent_point_never_body">Notification content, contact or group names, message text, your contacts, your installed apps.</string>
    <string name="consent_update_label">Check for new versions</string>
    <string name="consent_update_hint">One request a day to GitHub. No identifier is sent.</string>
    <string name="consent_details_show">What exactly is sent?</string>
    <string name="consent_details_hide">Hide details</string>
    <string name="consent_details">• An anonymous install identifier (random, not linked to your account or hardware)\n• App version, Android version, device model, language, theme\n• Features you used: apps enabled, colours changed, sender rules, animations, light duration, brightness and fade, reminder, support options\n• Each setup step and whether it worked, including whether the notification listener stayed connected\n• Update checks\n\nNever sent: notification content, sender or group names, message text, your contacts, or your list of installed apps.</string>
    <string name="consent_accept">Share anonymous statistics</string>
    <string name="consent_decline">No thanks</string>
